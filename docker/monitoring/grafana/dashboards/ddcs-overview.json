    {
      "id": 13,
      "type": "timeseries",
      "title": "Command success ratio",
      "description": "rate(succeeded)/rate(dispatched). 1.0 = 해당 창에서 dispatch된 논리 명령이 성공으로 종결.",
      "datasource": {
        "type": "prometheus",
        "uid": "ddcs-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ddcs_commands_succeeded_total[$__rate_interval]) / rate(ddcs_commands_dispatched_total[$__rate_interval])",
          "legendFormat": "success ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
