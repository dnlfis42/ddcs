    {
      "id": 51,
      "type": "timeseries",
      "title": "Sweep tick duration (us)",
      "description": "주기 sweep tick 작업 시간(마이크로초). 단일 스레드 포화 신호: sweep 주기(기본 1s = 1e6 us)에 근접하면 한 코어가 포화에 이른다. gauge ddcs_sweep_duration_us / _max + 평균(sum/ticks).",
      "datasource": {
        "type": "prometheus",
        "uid": "ddcs-prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 80
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ddcs_sweep_duration_us_sum[$__rate_interval]) / rate(ddcs_sweep_ticks_total[$__rate_interval])",
          "legendFormat": "avg"
        },
        {
          "refId": "B",
          "expr": "ddcs_sweep_duration_us",
          "legendFormat": "last"
        },
        {
          "refId": "C",
          "expr": "ddcs_sweep_duration_us_max",
          "legendFormat": "max (since start)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
