{
  "uid": "ddcs-overview",
  "title": "DDCS Controller Overview",
  "tags": [
    "ddcs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "group",
        "label": "그룹별 정책",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "ddcs-prometheus"
        },
        "definition": "label_values(ddcs_group_devices, group)",
        "query": "label_values(ddcs_group_devices, group)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
