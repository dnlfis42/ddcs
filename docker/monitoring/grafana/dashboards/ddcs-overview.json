    {
      "id": 51,
      "type": "timeseries",
      "title": "Controller tick duration (ms)",
      "description": "주기 Controller tick 작업 시간. 단일 스레드 포화 신호: tick 주기(기본 1s)에 근접하면 한 코어가 포화에 이른다. Prometheus seconds를 화면에서 ms로 환산한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "ddcs-prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 80
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * rate(ddcs_tick_duration_seconds_total[$__rate_interval]) / rate(ddcs_ticks_total[$__rate_interval])",
          "legendFormat": "avg"
        },
        {
          "refId": "B",
          "expr": "1000 * ddcs_tick_duration_seconds",
          "legendFormat": "last"
        },
        {
          "refId": "C",
          "expr": "1000 * ddcs_tick_duration_seconds_max",
          "legendFormat": "max (since start)"
