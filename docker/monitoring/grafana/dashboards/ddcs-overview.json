{
  "uid": "ddcs-overview",
  "title": "DDCS Controller Overview",
  "tags": ["ddcs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Fleet 개요",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active connections",
      "description": "현재 세션 연결 수 (모든 단계). gauge ddcs_connections.",
      "datasource": { "type": "prometheus", "uid": "ddcs-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [{ "refId": "A", "expr": "ddcs_connections", "legendFormat": "connections" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Known devices",
      "description": "영속적으로 알려진 Device 수 (uuid 기준). gauge ddcs_devices_known.",
      "datasource": { "type": "prometheus", "uid": "ddcs-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [{ "refId": "A", "expr": "ddcs_devices_known", "legendFormat": "devices" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Pending commands",
      "description": "결과 대기중인 in-flight 명령 수. gauge ddcs_commands_pending.",
      "datasource": { "type": "prometheus", "uid": "ddcs-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "targets": [{ "refId": "A", "expr": "ddcs_commands_pending", "legendFormat": "pending" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Avg command RTT",
      "description": "완료 명령 평균 RTT = rate(rtt_ms_sum)/rate(completed_total). 무완료 구간은 표시 없음.",
      "datasource": { "type": "prometheus", "uid": "ddcs-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ddcs_command_rtt_ms_sum[$__rate_interval]) / rate(ddcs_commands_completed_total[$__rate_interval])",
          "legendFormat": "avg RTT"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 3000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "명령 처리량 (RED)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Command rates (ops/s)",
      "description": "명령 수명주기 카운터의 초당 증가율.",
      "datasource": { "type": "prometheus", "uid": "ddcs-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ddcs_commands_dispatched_total[$__rate_interval])",
          "legendFormat": "dispatched"
        },
        { "refId": "B", "expr": "rate(ddcs_commands_completed_total[$__rate_interval])", "legendFormat": "completed" },
        { "refId": "C", "expr": "rate(ddcs_commands_timed_out_total[$__rate_interval])", "legendFormat": "timed_out" },
        { "refId": "D", "expr": "rate(ddcs_commands_retried_total[$__rate_interval])", "legendFormat": "retried" },
        {
          "refId": "E",
          "expr": "rate(ddcs_commands_superseded_total[$__rate_interval])",
          "legendFormat": "superseded"
        },
        { "refId": "F", "expr": "rate(ddcs_commands_stale_total[$__rate_interval])", "legendFormat": "stale" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Avg command RTT (ms)",
      "description": "rate(rtt_ms_sum)/rate(completed_total).",
      "datasource": { "type": "prometheus", "uid": "ddcs-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ddcs_command_rtt_ms_sum[$__rate_interval]) / rate(ddcs_commands_completed_total[$__rate_interval])",
          "legendFormat": "avg RTT"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Command success ratio",
      "description": "rate(completed)/rate(dispatched). 1.0 = 모든 명령 성공.",
      "datasource": { "type": "prometheus", "uid": "ddcs-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ddcs_commands_completed_total[$__rate_interval]) / rate(ddcs_commands_dispatched_total[$__rate_interval])",
          "legendFormat": "success ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Pending commands over time",
      "description": "gauge ddcs_commands_pending 추이.",
      "datasource": { "type": "prometheus", "uid": "ddcs-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "targets": [{ "refId": "A", "expr": "ddcs_commands_pending", "legendFormat": "pending" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 15, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "건강 / 알람",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Alarm rates (ops/s)",
      "description": "운영 알람 카운터 증가율: 명령 최종 실패 + 세션 건강.",
      "datasource": { "type": "prometheus", "uid": "ddcs-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ddcs_commands_gave_up_total[$__rate_interval])",
          "legendFormat": "commands_gave_up"
        },
        { "refId": "B", "expr": "rate(ddcs_agents_evicted_total[$__rate_interval])", "legendFormat": "agents_evicted" },
        {
          "refId": "C",
          "expr": "rate(ddcs_handshake_expired_total[$__rate_interval])",
          "legendFormat": "handshake_expired"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10, "showPoints": "auto" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Alarm totals (cumulative)",
      "description": "누적 알람 카운터.",
      "datasource": { "type": "prometheus", "uid": "ddcs-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "refId": "A", "expr": "ddcs_commands_gave_up_total", "legendFormat": "commands_gave_up" },
        { "refId": "B", "expr": "ddcs_agents_evicted_total", "legendFormat": "agents_evicted" },
        { "refId": "C", "expr": "ddcs_handshake_expired_total", "legendFormat": "handshake_expired" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Connections & known devices over time",
      "description": "gauge ddcs_connections, ddcs_devices_known 추이.",
      "datasource": { "type": "prometheus", "uid": "ddcs-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "targets": [
        { "refId": "A", "expr": "ddcs_connections", "legendFormat": "connections" },
        { "refId": "B", "expr": "ddcs_devices_known", "legendFormat": "devices_known" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 40,
      "type": "row",
      "title": "그룹(zone)별 정책",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "panels": []
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Group avg load",
      "description": "그룹별 active device 평균 load (정책 입력 신호). gauge ddcs_group_load_avg{group}.",
      "datasource": { "type": "prometheus", "uid": "ddcs-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 41 },
      "targets": [{ "refId": "A", "expr": "ddcs_group_load_avg", "legendFormat": "{{group}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "min", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Devices by group & mode",
      "description": "그룹×모드별 active device 수. 정책이 group마다 다른 mode로 구동함을 보여준다. gauge ddcs_group_devices{group,mode}.",
      "datasource": { "type": "prometheus", "uid": "ddcs-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 41 },
      "targets": [{ "refId": "A", "expr": "ddcs_group_devices", "legendFormat": "{{group}} · {{mode}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 0, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 43,
      "type": "timeseries",
      "title": "Group avg temp",
      "description": "그룹별 active device 평균 온도(C). mode-구동 상태(performance 가열 / safe 냉각). gauge ddcs_group_temp_avg{group}.",
      "datasource": { "type": "prometheus", "uid": "ddcs-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 49 },
      "targets": [{ "refId": "A", "expr": "ddcs_group_temp_avg", "legendFormat": "{{group}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "min", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 50,
      "type": "row",
      "title": "성능 / 포화",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 57 },
      "panels": []
    },
    {
      "id": 51,
      "type": "timeseries",
      "title": "Sweep tick duration (us)",
      "description": "주기 sweep tick 작업 시간(마이크로초). 단일 스레드 포화 신호: sweep 주기(기본 1s = 1e6 us)에 근접하면 한 코어가 포화. gauge ddcs_sweep_duration_us / _max + 평균(sum/ticks).",
      "datasource": { "type": "prometheus", "uid": "ddcs-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 58 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ddcs_sweep_duration_us_sum[$__rate_interval]) / rate(ddcs_sweep_ticks_total[$__rate_interval])",
          "legendFormat": "avg"
        },
        { "refId": "B", "expr": "ddcs_sweep_duration_us", "legendFormat": "last" },
        { "refId": "C", "expr": "ddcs_sweep_duration_us_max", "legendFormat": "max (since start)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 52,
      "type": "timeseries",
      "title": "Command RTT percentiles (ms)",
      "description": "histogram ddcs_command_rtt_ms 로 계산한 명령 RTT 분포. 평균이 숨기는 꼬리를 p50/p99로 본다.",
      "datasource": { "type": "prometheus", "uid": "ddcs-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 58 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(ddcs_command_rtt_ms_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum(rate(ddcs_command_rtt_ms_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
