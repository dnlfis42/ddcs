    {
      "id": 21,
      "type": "timeseries",
      "title": "Alarm rates (ops/s)",
      "description": "운영 알람 카운터 증가율: 명령 최종 실패 + 세션 건강.",
      "datasource": {
        "type": "prometheus",
        "uid": "ddcs-prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 16,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ddcs_commands_failed_total[$__rate_interval]))",
          "legendFormat": "commands terminal failed"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ddcs_command_dispatch_failures_total[$__rate_interval]))",
          "legendFormat": "initial dispatch failed"
        },
        {
          "refId": "C",
          "expr": "sum by (reason) (rate(ddcs_connections_closed_total{reason=~\"liveness_expired|handshake_expired\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "showPoints": "auto"
