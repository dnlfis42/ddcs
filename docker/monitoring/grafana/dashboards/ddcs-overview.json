{
  "uid": "ddcs-overview",
  "title": "DDCS Controller Overview",
  "tags": ["ddcs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "group",
        "label": "그룹별 정책",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "ddcs-prometheus"
        },
        "definition": "label_values(ddcs_group_devices, group)",
        "query": "label_values(ddcs_group_devices, group)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "sort": 1,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Fleet 개요",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active connections",
      "description": "현재 세션 연결 수 (모든 단계). gauge ddcs_connections.",
      "datasource": {
        "type": "prometheus",
        "uid": "ddcs-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ddcs_connections",
          "legendFormat": "connections"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Managed devices",
      "description": "Controller 프로세스 수명 동안 관리한 Device 수 (uuid 기준). gauge ddcs_devices.",
      "datasource": {
        "type": "prometheus",
        "uid": "ddcs-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ddcs_devices",
          "legendFormat": "devices"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Pending commands",
      "description": "결과 대기중인 in-flight 명령 수. gauge ddcs_commands_pending.",
      "datasource": {
        "type": "prometheus",
        "uid": "ddcs-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ddcs_commands_pending",
          "legendFormat": "pending"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Avg command RTT",
      "description": "성공 outcome 평균 RTT = 1000 × rate(rtt_seconds_sum)/rate(rtt_seconds_count). 무완료 구간은 표시 없음.",
      "datasource": {
        "type": "prometheus",
        "uid": "ddcs-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * rate(ddcs_command_rtt_seconds_sum[$__rate_interval]) / rate(ddcs_command_rtt_seconds_count[$__rate_interval])",
          "legendFormat": "avg RTT"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1000
              },
              {
                "color": "red",
                "value": 3000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "명령 처리량 (RED)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Command rates (ops/s)",
      "description": "논리 명령 terminal state, 첫 송신 실패, attempt 실패를 분리한 초당 증가율.",
      "datasource": {
        "type": "prometheus",
        "uid": "ddcs-prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ddcs_commands_dispatched_total[$__rate_interval])",
          "legendFormat": "dispatched"
        },
        {
          "refId": "B",
          "expr": "rate(ddcs_commands_succeeded_total[$__rate_interval])",
          "legendFormat": "succeeded"
        },
        {
          "refId": "C",
          "expr": "sum(rate(ddcs_commands_failed_total[$__rate_interval]))",
          "legendFormat": "terminal failed"
        },
        {
          "refId": "D",
          "expr": "sum(rate(ddcs_command_dispatch_failures_total[$__rate_interval]))",
          "legendFormat": "initial dispatch failed"
        },
        {
          "refId": "E",
          "expr": "sum(rate(ddcs_command_attempt_failures_total[$__rate_interval]))",
          "legendFormat": "attempt failed"
        },
        {
          "refId": "F",
          "expr": "rate(ddcs_command_resends_total[$__rate_interval])",
          "legendFormat": "resends"
        },
        {
          "refId": "G",
          "expr": "rate(ddcs_commands_superseded_total[$__rate_interval])",
          "legendFormat": "superseded"
        },
        {
          "refId": "H",
          "expr": "rate(ddcs_command_stale_responses_total[$__rate_interval])",
          "legendFormat": "stale responses"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["last", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Avg command RTT (ms)",
      "description": "1000 × rate(rtt_seconds_sum)/rate(rtt_seconds_count).",
