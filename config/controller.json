{
  "log": {
    "level": "info"
  },
  "controller": {
    "sweep_interval_ms": 1000
  },
  "profile": {
    "enabled": false
  },
  "prometheus": {
    "port": 9000
  },
  "transport": {
    "port": 8080,
    "accept_backlog": 128,
    "rx_buffer_size": 4096
  },
  "session": {
    "handshake_timeout_ms": 3000,
    "liveness_timeout_ms": 1500
  },
  "command": {
    "timeout_ms": 5000,
    "max_attempts": 3,
    "backoff_base_ms": 500
  },
  "policy": {
    "groups": {
      "zone_a": {
        "busy_load": 70,
        "idle_load": 30,
        "hot_temp": 65,
        "cool_temp": 50,
        "busy_mode": "performance",
        "idle_mode": "normal",
        "hot_mode": "safe"
      },
      "zone_b": {
        "busy_load": 60,
        "idle_load": 45,
        "hot_temp": 65,
        "cool_temp": 50,
        "busy_mode": "performance",
        "idle_mode": "normal",
        "hot_mode": "safe"
      },
      "zone_c": {
        "busy_load": 80,
        "idle_load": 20,
        "hot_temp": 65,
        "cool_temp": 50,
        "busy_mode": "performance",
        "idle_mode": "normal",
        "hot_mode": "safe"
      },
      "zone_d": {
        "busy_load": 75,
        "idle_load": 40,
        "hot_temp": 65,
        "cool_temp": 50,
        "busy_mode": "performance",
        "idle_mode": "normal",
        "hot_mode": "safe"
      }
    }
  }
}
